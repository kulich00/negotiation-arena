APP_ENV=development
HTTP_ADDR=:8080

# PostgreSQL. Compose использует имя сервиса db; для запуска на хосте укажите localhost.
DATABASE_URL=postgres://arena:arena@db:5432/arena?sslmode=disable

# Администратор и защита входа.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TTL=12h
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW=15m

# Лимит публичных изменяющих запросов. Proxy headers локально не доверяются.
API_RATE_LIMIT=120
API_RATE_WINDOW=1m
TRUST_PROXY_HEADERS=false

# AI: mock работает автономно; для Gemini задайте пул из 1-8 ключей.
LLM_PROVIDER=mock
# Ключи через запятую; LLM_API_KEYS имеет приоритет над LLM_API_KEY.
LLM_API_KEYS=
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO

