APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://arena:arena@db:5432/arena?sslmode=disable
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TTL=12h
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW=15m
API_RATE_LIMIT=120
API_RATE_WINDOW=1m
TRUST_PROXY_HEADERS=false
LLM_PROVIDER=mock
# Comma-separated pool of 1-8 keys. Takes priority over LLM_API_KEY.
LLM_API_KEYS=
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

